# Never commit credentials. Database passwords must be URL-safe.
POSTGRES_PASSWORD=
POSTGRES_DB=catalog
# Use the full tested Git SHA for releases; dev is only for local builds.
XIAOYI_RELEASE=dev
XIAOYI_LLM_BASE_URL=
XIAOYI_LLM_MODEL=
XIAOYI_LLM_API_KEY=
HF_ENDPOINT=https://huggingface.co
HF_TOKEN=
XIAOYI_STORAGE_QUOTA_BYTES=107374182400
XIAOYI_DOWNLOAD_MAX_BYTES=10737418240
XIAOYI_CATALOG_CORS=http://localhost:8080
# Set to 1 behind the team's HTTPS reverse proxy.
XIAOYI_SECURE_COOKIE=0
XIAOYI_CATALOG_AUTO_SUMMARY=1
# Set to 0 to suspend new scheduled dispatches during maintenance.
XIAOYI_SCHEDULES_ENABLED=1
