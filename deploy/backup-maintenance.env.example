# Install as /etc/xiaoyi/backup-maintenance.env (root-owned, mode 0600).
XIAOYI_PROJECT_DIR=/srv/xiaoyi_data
# Must match the project that is already running; inspect docker compose ls.
COMPOSE_PROJECT_NAME=xiaoyi_data
XIAOYI_OFFSITE_MOUNT=/mnt/xiaoyi-offsite
XIAOYI_OFFSITE_DIR=/mnt/xiaoyi-offsite/catalog
# Exact findmnt -n -o SOURCE --target /mnt/xiaoyi-offsite/catalog output.
# This example must be replaced with your separately managed backup host.
XIAOYI_OFFSITE_EXPECTED_SOURCE=backup-host:/exports/xiaoyi
XIAOYI_MAINTENANCE_LOCK=/run/lock/xiaoyi-catalog-maintenance.lock
# All manual import/derive/migrate/restore commands must acquire the same lock.
# No external writer or second deployment may share this database/assets.
XIAOYI_MAINTENANCE_ACK=exclusive-compose-writers
# Preserve the same Compose overrides as the running deployment, if any:
# COMPOSE_FILE=/srv/xiaoyi_data/compose.yaml:/srv/xiaoyi_data/deploy/compose.recovery.yaml
# XIAOYI_RECOVERY_ASSETS=/srv/xiaoyi-restored/assets
