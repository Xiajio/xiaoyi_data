# Digests verified against Docker Hub on 2026-10-18; refresh deliberately with CI.
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258 AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY platform/requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r /app/requirements.lock
COPY platform/ /app/platform/
RUN pip install --no-cache-dir --no-deps --no-build-isolation /app/platform
RUN useradd --uid 10001 --create-home catalog && mkdir -p /data/assets && chown -R catalog:catalog /data
USER catalog
CMD ["python","-m","uvicorn","xiaoyi_catalog.service:create_app","--factory","--host","0.0.0.0","--port","5280"]

FROM runtime AS ops
USER root
# PGDG publishes the client matching the server major; run pg_dump --version in CI.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/* \
    && pg_dump --version && pg_restore --version
USER catalog
