FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY platform/ /app/platform/
RUN pip install --no-cache-dir /app/platform
RUN useradd --uid 10001 --create-home catalog && mkdir -p /data/assets && chown -R catalog:catalog /data
USER catalog
CMD ["python","-m","uvicorn","xiaoyi_catalog.service:create_app","--factory","--host","0.0.0.0","--port","5280"]
